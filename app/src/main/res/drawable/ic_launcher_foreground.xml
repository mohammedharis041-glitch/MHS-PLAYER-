<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer glassmorphic circle -->
    <path
        android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:type="radial">
                <item android:color="#3300E5FF" android:offset="0" />
                <item android:color="#1100E5FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner vibrant play button -->
    <path
        android:pathData="M44,38 L72,54 L44,70 Z"
        android:fillAlpha="0.9">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="38"
                android:endX="72"
                android:endY="70"
                android:type="linear">
                <item android:color="#FF00E5FF" android:offset="0" />
                <item android:color="#FF0082FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle glow overlay -->
    <path
        android:pathData="M54,54m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0"
        android:strokeWidth="1.5"
        android:strokeColor="#40FFFFFF" />
        
</vector>
